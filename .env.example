# ==========================================
# UrbanFlow - Configuration d'environnement
# Fichier d'exemple (.env.example)
# ==========================================
# Instructions :
# Copiez ce fichier et renommez-le en ".env"
# Remplissez ensuite vos vraies valeurs.
# NE JAMAIS COMMITER LE VRAI FICHIER .env !
# ==========================================

# ─── Base de Données PostgreSQL ───────────
POSTGRES_USER=urbanflow_admin
POSTGRES_PASSWORD=votre_mot_de_passe_robuste_ici
POSTGRES_DB=urbanflow_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Cache Redis ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Clés d'API Externes ──────────────────
# Obtenez une clé gratuite sur : https://openweathermap.org/api
OPENWEATHER_API_KEY=votre_cle_api_openweathermap_ici

# Obtenez une clé sur : https://prim.iledefrance-mobilites.fr/
IDF_MOBILITES_API_KEY=votre_cle_api_idf_mobilites_ici

# ─── Configuration Backend FastAPI ────────
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
